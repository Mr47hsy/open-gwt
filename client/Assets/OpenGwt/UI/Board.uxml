<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="Board.uss" />
    <ui:VisualElement name="root" class="board">

        <ui:VisualElement name="match" class="match hidden">
            <ui:VisualElement name="top-bar" class="bar bar--tall">
                <ui:Label name="opp-name" class="bar__name" />
                <ui:Label name="opp-score" text="0" class="bar__score" />
                <ui:Label name="opp-rounds" class="bar__rounds" />
                <ui:Label name="opp-hand" class="bar__info" />
                <ui:Label name="opp-graveyard" class="bar__zone" />
                <ui:Label name="opp-banished" class="bar__zone" />
                <ui:Label name="opp-mulligan" class="bar__info" />
                <ui:Label name="opp-passed" class="bar__passed" />
                <ui:VisualElement class="bar__spacer" />
                <ui:VisualElement name="opp-leader-slot" class="bar__leader" />
                <ui:Label name="round-label" class="bar__info" />
                <ui:Label name="turn-label" class="bar__turn" />
                <ui:Button name="btn-leave" class="button" />
            </ui:VisualElement>

            <ui:VisualElement name="opp-board" class="side side--opponent">
                <ui:VisualElement name="opp-row-ranged" class="row"><ui:VisualElement class="row__head"><ui:VisualElement name="icon" class="row__icon icon--ranged" /><ui:Label name="label" class="row__label" /></ui:VisualElement><ui:Label name="effects" class="row__effects" /><ui:VisualElement name="units" class="row__units" /><ui:Label name="total" class="row__total" text="0" /></ui:VisualElement>
                <ui:VisualElement name="opp-row-melee" class="row"><ui:VisualElement class="row__head"><ui:VisualElement name="icon" class="row__icon icon--melee" /><ui:Label name="label" class="row__label" /></ui:VisualElement><ui:Label name="effects" class="row__effects" /><ui:VisualElement name="units" class="row__units" /><ui:Label name="total" class="row__total" text="0" /></ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="middle" class="middle">
                <ui:Label name="status-label" class="middle__status" />
                <ui:VisualElement name="prompt" class="prompt hidden">
                    <ui:VisualElement name="prompt-card" class="prompt__card" />
                    <ui:Label name="prompt-text" class="prompt__text" />
                    <ui:Label name="prompt-source" class="prompt__source" />
                    <ui:Button name="btn-end-mulligan" class="button button--primary hidden" />
                    <ui:Button name="btn-cancel-choice" class="button hidden" />
                </ui:VisualElement>
                <ui:Label name="message-label" class="middle__message" />
            </ui:VisualElement>

            <ui:VisualElement name="my-board" class="side side--mine">
                <ui:VisualElement name="my-row-melee" class="row"><ui:VisualElement class="row__head"><ui:VisualElement name="icon" class="row__icon icon--melee" /><ui:Label name="label" class="row__label" /></ui:VisualElement><ui:Label name="effects" class="row__effects" /><ui:VisualElement name="units" class="row__units" /><ui:Label name="total" class="row__total" text="0" /></ui:VisualElement>
                <ui:VisualElement name="my-row-ranged" class="row"><ui:VisualElement class="row__head"><ui:VisualElement name="icon" class="row__icon icon--ranged" /><ui:Label name="label" class="row__label" /></ui:VisualElement><ui:Label name="effects" class="row__effects" /><ui:VisualElement name="units" class="row__units" /><ui:Label name="total" class="row__total" text="0" /></ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="bottom-bar" class="bar bar--tall">
                <ui:Label name="my-name" class="bar__name" />
                <ui:Label name="my-score" text="0" class="bar__score" />
                <ui:Label name="my-rounds" class="bar__rounds" />
                <ui:Label name="deck-count" class="bar__info" />
                <ui:Label name="my-graveyard" class="bar__zone" />
                <ui:Label name="my-banished" class="bar__zone" />
                <ui:Label name="my-passed" class="bar__passed" />
                <ui:VisualElement class="bar__spacer" />
                <ui:VisualElement name="leader-slot" class="bar__leader" />
                <ui:Button name="btn-end-turn" class="button button--primary" />
                <ui:Button name="btn-pass" class="button" />
            </ui:VisualElement>

            <ui:ScrollView name="hand" mode="Horizontal" class="hand" />
            <ui:Label name="event-log" class="event-log" />
        </ui:VisualElement>

        <ui:VisualElement name="fx-layer" class="fx-layer" picking-mode="Ignore" />

        <ui:VisualElement name="connect-panel" class="overlay">
            <ui:VisualElement class="dialog">
                <ui:Label name="title" text="open-gwt" class="dialog__title" />
                <ui:Label name="disclaimer" class="dialog__note" />
                <ui:VisualElement name="connect-step">
                    <ui:TextField name="server-url" value="http://127.0.0.1:8000" class="field" />
                    <ui:TextField name="display-name" value="Player" class="field" />
                    <ui:DropdownField name="language" class="field" />
                    <ui:VisualElement class="dialog__buttons">
                        <ui:Button name="btn-connect" class="button button--primary" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="lobby-step" class="hidden">
                    <ui:DropdownField name="deck" class="field" />
                    <ui:VisualElement name="deck-summary" class="deck-summary" />
                    <ui:VisualElement class="dialog__buttons">
                        <ui:Button name="btn-bot" class="button button--primary" />
                        <ui:Button name="btn-create-room" class="button" />
                    </ui:VisualElement>
                    <ui:VisualElement class="dialog__buttons">
                        <ui:TextField name="room-code-input" class="field field--code" />
                        <ui:Button name="btn-join-room" class="button" />
                    </ui:VisualElement>
                    <ui:VisualElement class="dialog__buttons">
                        <ui:Button name="btn-back" class="button" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="connect-status" class="dialog__status" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="modal" class="overlay hidden">
            <ui:VisualElement class="dialog dialog--wide">
                <ui:Label name="modal-title" class="dialog__title" />
                <ui:VisualElement name="modal-options" class="modal__options" />
                <ui:VisualElement class="dialog__buttons">
                    <ui:Button name="modal-cancel" class="button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="card-preview" class="preview" picking-mode="Ignore" />

    </ui:VisualElement>
</ui:UXML>
