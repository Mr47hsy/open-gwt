{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opengwt:protocol:cards:2",
  "title": "open-gwt cards file (schema opengwt.cards/2)",
  "type": "object",
  "required": [
    "schema",
    "faction",
    "cards"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "opengwt.cards/2"
    },
    "faction": {
      "$ref": "#/$defs/id"
    },
    "cards": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/card"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "tag": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}$"
    },
    "tags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tag"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "row": {
      "enum": [
        "melee",
        "ranged"
      ]
    },
    "rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/row"
      },
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true
    },
    "side": {
      "enum": [
        "self",
        "opponent"
      ]
    },
    "sides": {
      "enum": [
        "self",
        "opponent",
        "both"
      ]
    },
    "color": {
      "enum": [
        "bronze",
        "gold"
      ]
    },
    "status": {
      "enum": [
        "locked",
        "shielded",
        "immune",
        "poisoned",
        "bleeding",
        "growing",
        "banish_on_leave",
        "kept_at_round_end"
      ]
    },
    "statuses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/status"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "innateStatus": {
      "enum": [
        "shielded",
        "immune",
        "banish_on_leave",
        "kept_at_round_end"
      ]
    },
    "rowEffect": {
      "enum": [
        "damage_strongest",
        "damage_weakest",
        "damage_random",
        "boost_random",
        "damage_on_arrival"
      ]
    },
    "trigger": {
      "enum": [
        "on_play",
        "on_activate",
        "on_destroyed",
        "on_turn_start",
        "on_turn_end",
        "on_round_end",
        "on_ally_played",
        "on_boosted",
        "on_damaged",
        "while_on_board"
      ]
    },
    "positiveInt": {
      "type": "integer",
      "minimum": 1
    },
    "nonNegativeInt": {
      "type": "integer",
      "minimum": 0
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "charges": {
          "$ref": "#/$defs/positiveInt"
        },
        "cooldown": {
          "$ref": "#/$defs/positiveInt"
        },
        "ready_on_play": {
          "const": true
        }
      }
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "on_row": {
          "$ref": "#/$defs/row"
        },
        "trigger_unit": {
          "$ref": "#/$defs/where"
        }
      }
    },
    "where": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "kind": {
          "type": "array",
          "items": {
            "enum": [
              "unit",
              "special",
              "artifact"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "tags_any": {
          "$ref": "#/$defs/tags"
        },
        "tags_none": {
          "$ref": "#/$defs/tags"
        },
        "statuses_any": {
          "$ref": "#/$defs/statuses"
        },
        "statuses_none": {
          "$ref": "#/$defs/statuses"
        },
        "same_id_as_this": {
          "const": true
        },
        "power_at_least": {
          "$ref": "#/$defs/nonNegativeInt"
        },
        "power_at_most": {
          "$ref": "#/$defs/nonNegativeInt"
        },
        "stronger_than_this": {
          "const": true
        }
      }
    },
    "unitTarget": {
      "type": "object",
      "required": [
        "units"
      ],
      "additionalProperties": false,
      "properties": {
        "units": {
          "enum": [
            "chosen",
            "chosen_row",
            "all",
            "random",
            "strongest",
            "weakest",
            "this",
            "adjacent",
            "trigger_unit",
            "previous_targets"
          ]
        },
        "side": {
          "$ref": "#/$defs/sides"
        },
        "rows": {
          "$ref": "#/$defs/rows"
        },
        "count": {
          "$ref": "#/$defs/positiveInt"
        },
        "where": {
          "$ref": "#/$defs/where"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "units": {
                "enum": [
                  "chosen",
                  "chosen_row",
                  "all",
                  "random",
                  "strongest",
                  "weakest"
                ]
              }
            }
          },
          "then": {
            "required": [
              "side"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "side"
                  ]
                },
                {
                  "required": [
                    "rows"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "units": {
                "const": "random"
              }
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "count"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "rowTarget": {
      "type": "object",
      "required": [
        "pick"
      ],
      "additionalProperties": false,
      "properties": {
        "pick": {
          "enum": [
            "chosen",
            "all",
            "this"
          ]
        },
        "side": {
          "$ref": "#/$defs/sides"
        },
        "rows": {
          "$ref": "#/$defs/rows"
        }
      },
      "if": {
        "properties": {
          "pick": {
            "const": "this"
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "side"
              ]
            },
            {
              "required": [
                "rows"
              ]
            }
          ]
        }
      },
      "else": {
        "required": [
          "side"
        ]
      }
    },
    "cardSource": {
      "type": "object",
      "required": [
        "pick"
      ],
      "additionalProperties": false,
      "properties": {
        "pick": {
          "enum": [
            "chosen",
            "random",
            "first",
            "all"
          ]
        },
        "side": {
          "$ref": "#/$defs/side"
        },
        "count": {
          "$ref": "#/$defs/positiveInt"
        },
        "offer": {
          "type": "integer",
          "minimum": 2
        },
        "where": {
          "$ref": "#/$defs/where"
        }
      },
      "if": {
        "properties": {
          "pick": {
            "const": "chosen"
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "count"
              ]
            }
          ]
        }
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "offer"
              ]
            }
          ]
        }
      }
    },
    "card": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "unit",
            "special",
            "artifact",
            "leader"
          ]
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "provisions": {
          "$ref": "#/$defs/nonNegativeInt"
        },
        "provision_bonus": {
          "$ref": "#/$defs/nonNegativeInt"
        },
        "token": {
          "const": true
        },
        "power": {
          "$ref": "#/$defs/positiveInt"
        },
        "armor": {
          "$ref": "#/$defs/positiveInt"
        },
        "rows": {
          "$ref": "#/$defs/rows"
        },
        "side": {
          "$ref": "#/$defs/side"
        },
        "statuses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/innateStatus"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "tags": {
          "$ref": "#/$defs/tags"
        },
        "activation": {
          "$ref": "#/$defs/activation"
        },
        "abilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ability"
          },
          "minItems": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "unit"
              }
            }
          },
          "then": {
            "required": [
              "power"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "special"
              }
            }
          },
          "then": {
            "required": [
              "abilities"
            ],
            "allOf": [
              {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "power"
                      ]
                    },
                    {
                      "required": [
                        "armor"
                      ]
                    },
                    {
                      "required": [
                        "rows"
                      ]
                    },
                    {
                      "required": [
                        "side"
                      ]
                    },
                    {
                      "required": [
                        "statuses"
                      ]
                    },
                    {
                      "required": [
                        "activation"
                      ]
                    },
                    {
                      "required": [
                        "token"
                      ]
                    }
                  ]
                }
              }
            ],
            "properties": {
              "abilities": {
                "items": {
                  "properties": {
                    "when": {
                      "const": "on_play"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "artifact"
              }
            }
          },
          "then": {
            "allOf": [
              {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "power"
                      ]
                    },
                    {
                      "required": [
                        "armor"
                      ]
                    },
                    {
                      "required": [
                        "side"
                      ]
                    }
                  ]
                }
              }
            ],
            "properties": {
              "abilities": {
                "items": {
                  "properties": {
                    "when": {
                      "not": {
                        "enum": [
                          "on_boosted",
                          "on_damaged"
                        ]
                      }
                    }
                  }
                }
              },
              "statuses": {
                "items": {
                  "not": {
                    "const": "shielded"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "leader"
              }
            }
          },
          "then": {
            "required": [
              "provision_bonus",
              "abilities"
            ],
            "allOf": [
              {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "color"
                      ]
                    },
                    {
                      "required": [
                        "provisions"
                      ]
                    },
                    {
                      "required": [
                        "token"
                      ]
                    },
                    {
                      "required": [
                        "power"
                      ]
                    },
                    {
                      "required": [
                        "armor"
                      ]
                    },
                    {
                      "required": [
                        "rows"
                      ]
                    },
                    {
                      "required": [
                        "side"
                      ]
                    },
                    {
                      "required": [
                        "statuses"
                      ]
                    },
                    {
                      "required": [
                        "tags"
                      ]
                    }
                  ]
                }
              }
            ],
            "properties": {
              "abilities": {
                "items": {
                  "properties": {
                    "when": {
                      "const": "on_activate"
                    }
                  }
                }
              },
              "activation": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "ready_on_play"
                      ]
                    }
                  ]
                }
              }
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "provision_bonus"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "token"
            ]
          },
          "then": {
            "properties": {
              "kind": {
                "enum": [
                  "unit",
                  "artifact"
                ]
              }
            },
            "allOf": [
              {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "color"
                      ]
                    },
                    {
                      "required": [
                        "provisions"
                      ]
                    }
                  ]
                }
              }
            ]
          },
          "else": {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "unit",
                    "special",
                    "artifact"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "color",
                "provisions"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "activation"
            ]
          },
          "then": {
            "required": [
              "abilities"
            ],
            "properties": {
              "abilities": {
                "contains": {
                  "properties": {
                    "when": {
                      "const": "on_activate"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "ability": {
      "type": "object",
      "required": [
        "when",
        "do"
      ],
      "properties": {
        "when": {
          "$ref": "#/$defs/trigger"
        },
        "if": {
          "$ref": "#/$defs/conditions"
        },
        "do": {
          "enum": [
            "damage",
            "boost",
            "add_armor",
            "remove_damage",
            "raise_base_power",
            "destroy",
            "banish",
            "add_status",
            "remove_statuses",
            "move_to_other_row",
            "return_to_hand",
            "draw",
            "play_from_deck",
            "play_from_graveyard",
            "summon_from_deck",
            "place_new_card",
            "add_charges",
            "set_row_effect",
            "clear_row_effect",
            "continuous_boost"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "do": {
                "const": "damage"
              }
            },
            "required": [
              "do"
            ]
          },
          "then": {
            "$ref": "#/$defs/do_damage"
          }
        },
        {
          "if": {
            "properties": {
              "do": {
                "const": "boost"
              }
            },
            "required": [
              "do"
            ]
          },
          "then": {
            "$ref": "#/$defs/do_boost"
          }
        },
        {
          "if": {
            "properties": {
              "do": {
                "const": "add_armor"
              }
            },
            "required": [
              "do"
            ]
          },
          "then": {
            "$ref": "#/$defs/do_add_armor"
          }
        },
        {
          "if": {
            "properties": {
              "do": {
                "const": "remove_damage"
              }
            },
            "required": [
              "do"
            ]
          },
          "then": {
            "$ref": "#/$defs/do_remove_damage"
          }
        },
        {
          "if": {
            "properties": {
              "do": {
                "const": "raise_base_power"
              }
            },
            "required": [
              "do"
            ]
          },
          "then": {
            "$ref": "#/$defs/do_raise_base_power"
          }
        },
        {
          "if": {
            "properties": {
              "do": {
                "const": "destroy"
              }
            },
            "required": [
              "do"
            ]
          },
          "then": {
            "$ref": "#/$defs/do_destroy"
          }
        },
        {
          "if": {
            "properties": {
              "do": {
                "const": "banish"
              }
            },
            "required": [
              "do"
            ]
          },
          "then": {
            "$ref": "#/$defs/do_banish"
          }
        },
        {
          "if": {
            "properties": {
              "do": {
                "const": "add_status"
              }
            },
            "required": [
              "do"
            ]
          },
          "then": {
            "$ref": "#/$defs/do_add_status"
          }
        },
        {
          "if": {
            "properties": {
              "do": {
                "const": "remove_statuses"
              }
            },
            "required": [
              "do"
            ]
          },
          "then": {
            "$ref": "#/$defs/do_remove_statuses"
          }
        },
        {
          "if": {
            "properties": {
              "do": {
                "const": "move_to_other_row"
              }
            },
            "required": [
              "do"
            ]
          },
          "then": {
            "$ref": "#/$defs/do_move_to_other_row"
          }
        },
        {
          "if": {
            "properties": {
              "do": {
                "const": "return_to_hand"
              }
            },
            "required": [
              "do"
            ]
          },
          "then": {
            "$ref": "#/$defs/do_return_to_hand"
          }
        },
        {
          "if": {
            "properties": {
              "do": {
                "const": "draw"
              }
            },
            "required": [
              "do"
            ]
          },
          "then": {
            "$ref": "#/$defs/do_draw"
          }
        },
        {
          "if": {
            "properties": {
              "do": {
                "const": "play_from_deck"
              }
            },
            "required": [
              "do"
            ]
          },
          "then": {
            "$ref": "#/$defs/do_play_from_deck"
          }
        },
        {
          "if": {
            "properties": {
              "do": {
                "const": "play_from_graveyard"
              }
            },
            "required": [
              "do"
            ]
          },
          "then": {
            "$ref": "#/$defs/do_play_from_graveyard"
          }
        },
        {
          "if": {
            "properties": {
              "do": {
                "const": "summon_from_deck"
              }
            },
            "required": [
              "do"
            ]
          },
          "then": {
            "$ref": "#/$defs/do_summon_from_deck"
          }
        },
        {
          "if": {
            "properties": {
              "do": {
                "const": "place_new_card"
              }
            },
            "required": [
              "do"
            ]
          },
          "then": {
            "$ref": "#/$defs/do_place_new_card"
          }
        },
        {
          "if": {
            "properties": {
              "do": {
                "const": "add_charges"
              }
            },
            "required": [
              "do"
            ]
          },
          "then": {
            "$ref": "#/$defs/do_add_charges"
          }
        },
        {
          "if": {
            "properties": {
              "do": {
                "const": "set_row_effect"
              }
            },
            "required": [
              "do"
            ]
          },
          "then": {
            "$ref": "#/$defs/do_set_row_effect"
          }
        },
        {
          "if": {
            "properties": {
              "do": {
                "const": "clear_row_effect"
              }
            },
            "required": [
              "do"
            ]
          },
          "then": {
            "$ref": "#/$defs/do_clear_row_effect"
          }
        },
        {
          "if": {
            "properties": {
              "do": {
                "const": "continuous_boost"
              }
            },
            "required": [
              "do"
            ]
          },
          "then": {
            "$ref": "#/$defs/do_continuous_boost"
          }
        },
        {
          "if": {
            "properties": {
              "when": {
                "const": "while_on_board"
              }
            },
            "required": [
              "when"
            ]
          },
          "then": {
            "properties": {
              "do": {
                "const": "continuous_boost"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "when": {
                "not": {
                  "enum": [
                    "on_play",
                    "on_activate"
                  ]
                }
              }
            },
            "required": [
              "when"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "target"
                  ],
                  "properties": {
                    "target": {
                      "required": [
                        "units"
                      ],
                      "properties": {
                        "units": {
                          "enum": [
                            "chosen",
                            "chosen_row"
                          ]
                        }
                      }
                    }
                  }
                },
                {
                  "required": [
                    "row_target"
                  ],
                  "properties": {
                    "row_target": {
                      "required": [
                        "pick"
                      ],
                      "properties": {
                        "pick": {
                          "const": "chosen"
                        }
                      }
                    }
                  }
                },
                {
                  "required": [
                    "cards"
                  ],
                  "properties": {
                    "cards": {
                      "required": [
                        "pick"
                      ],
                      "properties": {
                        "pick": {
                          "const": "chosen"
                        }
                      }
                    }
                  }
                },
                {
                  "properties": {
                    "do": {
                      "enum": [
                        "play_from_deck",
                        "play_from_graveyard"
                      ]
                    }
                  },
                  "required": [
                    "do"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "when": {
                "not": {
                  "const": "on_ally_played"
                }
              }
            },
            "required": [
